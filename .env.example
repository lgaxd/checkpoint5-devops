# Azure CLI subscription (optional when the correct subscription is already selected)
AZURE_SUBSCRIPTION_ID=

# Resource naming; WEB_APP_NAME must be globally unique in Azure.
RM=561413
LOCATION=eastus2
# Opcional: região do Azure SQL (se vazio, usa LOCATION).
SQL_LOCATION=
RESOURCE_GROUP=561413-dimdim-rg
SQL_SERVER_NAME=sql-server-dimdim-561413
SQL_DATABASE_NAME=db-dimdim
APP_SERVICE_PLAN=561413-dimdim-plan
WEB_APP_NAME=561413-dimdim-webapp
APP_INSIGHTS_NAME=561413-dimdim-insights

# Azure SQL server administrator used only by azure-sql-init.sh
SQL_ADMIN_USERNAME=
SQL_ADMIN_PASSWORD=

# Contained database user used by the application (must differ from server admin).
DATABASE_USERNAME=
DATABASE_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=86400000

# Opcional: IPv4 público exato desta máquina. Se vazio, o deploy detecta via api.ipify.org.
CLIENT_IP=
